# --- Neon Postgres ---
# From your Neon project dashboard -> Connection string (use the "pooled" one)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/streampulse?sslmode=require

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_long_random_string
# Set to your real deployed URL in production (e.g. https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web application)
# Authorized redirect URI must be: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me

# --- Vercel Blob (audio file storage) ---
# From your Vercel project -> Storage -> Create Blob store -> copy the token
BLOB_READ_WRITE_TOKEN=replace_me
